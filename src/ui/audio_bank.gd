class_name AudioBank
extends Node
## Sound for the game.
##   - sfx(name): tiny retro sound effects SYNTHESISED in code (no audio files needed). See RECIPES.
##   - play_voice(dir, key): plays campaigns/<id>/voice/<key>.mp3 (or .ogg/.wav) if it exists.
##     Voice files are created by tools/gen_voices.mjs (ElevenLabs) - see docs/VOICE.md.
##   - music(dir, track): loops campaigns/<id>/music/<track>.ogg|mp3 if it exists.
## To add a sound effect: add an entry to RECIPES. Each note is
##   [start seconds, duration, start Hz, end Hz, volume 0..1, "sine" | "square" | "noise"]

const RATE := 22050
const RECIPES := {
	"dice": [[0.0, 0.03, 900, 500, 0.5, "noise"], [0.07, 0.03, 800, 400, 0.45, "noise"], [0.16, 0.03, 700, 400, 0.4, "noise"], [0.27, 0.04, 600, 300, 0.4, "noise"]],
	"dice_land": [[0.0, 0.05, 300, 120, 0.6, "noise"], [0.0, 0.08, 220, 110, 0.4, "sine"]],
	"hit": [[0.0, 0.12, 400, 80, 0.7, "noise"], [0.0, 0.16, 140, 60, 0.6, "sine"]],
	"crit": [[0.0, 0.14, 500, 80, 0.8, "noise"], [0.0, 0.18, 150, 55, 0.7, "sine"], [0.05, 0.3, 1320, 1320, 0.3, "sine"]],
	"miss": [[0.0, 0.16, 2000, 500, 0.25, "noise"]],
	"swing": [[0.0, 0.12, 900, 2400, 0.2, "noise"]],
	"cast": [[0.0, 0.35, 380, 1400, 0.35, "sine"], [0.05, 0.3, 760, 2100, 0.15, "sine"]],
	"heal": [[0.0, 0.2, 660, 660, 0.3, "sine"], [0.14, 0.3, 990, 990, 0.3, "sine"]],
	"coin": [[0.0, 0.08, 1760, 1760, 0.3, "square"], [0.07, 0.2, 2640, 2640, 0.25, "square"]],
	"item": [[0.0, 0.1, 880, 1320, 0.3, "sine"]],
	"quest": [[0.0, 0.14, 523, 523, 0.3, "square"], [0.12, 0.14, 659, 659, 0.3, "square"], [0.24, 0.3, 784, 784, 0.3, "square"]],
	"quest_done": [[0.0, 0.14, 523, 523, 0.3, "square"], [0.12, 0.14, 659, 659, 0.3, "square"], [0.24, 0.14, 784, 784, 0.3, "square"], [0.36, 0.45, 1047, 1047, 0.32, "square"]],
	"levelup": [[0.0, 0.1, 440, 440, 0.3, "square"], [0.09, 0.1, 554, 554, 0.3, "square"], [0.18, 0.1, 659, 659, 0.3, "square"], [0.27, 0.1, 880, 880, 0.3, "square"], [0.36, 0.5, 1109, 1109, 0.3, "square"]],
	"door": [[0.0, 0.3, 90, 140, 0.4, "square"], [0.28, 0.08, 200, 80, 0.5, "noise"]],
	"combat": [[0.0, 0.12, 110, 70, 0.8, "sine"], [0.18, 0.12, 110, 70, 0.8, "sine"], [0.36, 0.3, 147, 60, 0.8, "sine"], [0.36, 0.2, 600, 200, 0.3, "noise"]],
	"victory": [[0.0, 0.16, 523, 523, 0.3, "square"], [0.16, 0.16, 523, 523, 0.3, "square"], [0.32, 0.16, 784, 784, 0.3, "square"], [0.48, 0.6, 1047, 1047, 0.32, "square"]],
	"down": [[0.0, 0.5, 330, 80, 0.4, "square"]],
	"join": [[0.0, 0.12, 392, 392, 0.3, "sine"], [0.12, 0.25, 587, 587, 0.3, "sine"]],
	"rest": [[0.0, 0.4, 330, 262, 0.25, "sine"], [0.35, 0.6, 262, 196, 0.25, "sine"]],
	"drink": [[0.0, 0.07, 300, 500, 0.3, "sine"], [0.1, 0.07, 350, 560, 0.3, "sine"], [0.2, 0.1, 400, 640, 0.3, "sine"]],
	"click": [[0.0, 0.03, 1200, 900, 0.25, "square"]],
	"page": [[0.0, 0.12, 1800, 700, 0.15, "noise"]],
}

var _cache: Dictionary = {}
var _players: Array = []
var _voice: AudioStreamPlayer
var _music: AudioStreamPlayer
var _track := ""
var campaign_dir := ""
var muted := false


func _ready() -> void:
	for i in 6:
		var p := AudioStreamPlayer.new()
		add_child(p)
		_players.append(p)
	_voice = AudioStreamPlayer.new()
	add_child(_voice)
	_music = AudioStreamPlayer.new()
	_music.volume_db = -14.0
	add_child(_music)


## Call when a campaign is loaded so its own sfx/ folder is found.
func set_campaign(dir: String) -> void:
	campaign_dir = dir
	_cache.clear()


## Plays a sound by name. Order of preference: campaigns/<id>/sfx/<name>.mp3 (campaign sound),
## assets/sfx/<name>.mp3 (generated by `npm run sfx`), then the synthesised recipe above.
func sfx(sound: String) -> void:
	if muted or sound == "":
		return
	if not _cache.has(sound):
		var stream: AudioStream = null
		if campaign_dir != "":
			stream = _load_stream("%s/sfx/%s" % [campaign_dir, sound])
		if stream == null:
			stream = _load_stream("res://assets/sfx/%s" % sound)
		if stream == null and RECIPES.has(sound):
			stream = _synth(RECIPES[sound])
		_cache[sound] = stream
	if _cache[sound] == null:
		return
	for p in _players:
		if not p.playing:
			p.stream = _cache[sound]
			p.volume_db = -8.0
			p.play()
			return


static func _synth(notes: Array) -> AudioStreamWAV:
	var length := 0.0
	for n in notes:
		length = maxf(length, float(n[0]) + float(n[1]))
	var count := int(length * RATE) + 1
	var buf := PackedFloat32Array()
	buf.resize(count)
	var seed_v := 12345
	for n in notes:
		var start := int(float(n[0]) * RATE)
		var dur := maxi(1, int(float(n[1]) * RATE))
		var phase := 0.0
		for i in dur:
			var t := float(i) / dur
			var freq := lerpf(float(n[2]), float(n[3]), t)
			phase += freq / RATE
			var v := 0.0
			match n[5]:
				"sine":
					v = sin(phase * TAU)
				"square":
					v = 0.6 if fmod(phase, 1.0) < 0.5 else -0.6
				_:
					seed_v = (seed_v * 1103515245 + 12345) & 0x7fffffff
					v = float(seed_v % 2000) / 1000.0 - 1.0
			var env := minf(1.0, t * 30.0) * pow(1.0 - t, 1.5)
			if start + i < count:
				buf[start + i] += v * env * float(n[4])
	var data := PackedByteArray()
	data.resize(count * 2)
	for i in count:
		data.encode_s16(i * 2, int(clampf(buf[i], -1.0, 1.0) * 30000.0))
	var wav := AudioStreamWAV.new()
	wav.format = AudioStreamWAV.FORMAT_16_BITS
	wav.mix_rate = RATE
	wav.stereo = false
	wav.data = data
	return wav


static func _load_stream(path_no_ext: String) -> AudioStream:
	for ext in ["mp3", "ogg", "wav"]:
		var path := "%s.%s" % [path_no_ext, ext]
		if not FileAccess.file_exists(path):
			# exported builds only contain the imported resource, not the raw file
			if path.begins_with("res://") and ResourceLoader.exists(path):
				return load(path)
			continue
		match ext:
			"mp3":
				var s := AudioStreamMP3.new()
				s.data = FileAccess.get_file_as_bytes(path)
				return s
			"ogg":
				return AudioStreamOggVorbis.load_from_file(path)
			"wav":
				return AudioStreamWAV.load_from_file(path)
	return null


## Starts a voice clip. Returns false when there is no audio file for this key.
func play_voice(campaign_dir: String, key: String) -> bool:
	if muted or key == "" or campaign_dir == "":
		return false
	var stream := _load_stream("%s/voice/%s" % [campaign_dir, key])
	if stream == null:
		return false
	_voice.stream = stream
	_voice.play()
	return true


func voice_playing() -> bool:
	return _voice.playing


func stop_voice() -> void:
	_voice.stop()


## Loops campaigns/<id>/music/<track>.mp3 (made by `npm run music`). "" stops the music.
## Asking for the track that is already playing does nothing, so maps can share a track seamlessly.
func music(dir: String, track: String) -> void:
	if track == _track and (_music.playing or track == ""):
		return
	_track = track
	_music.stop()
	if track == "" or muted:
		return
	var stream := _load_stream("%s/music/%s" % [dir, track])
	if stream == null:
		return
	if stream is AudioStreamMP3 or stream is AudioStreamOggVorbis:
		stream.loop = true
	_music.stream = stream
	_music.play()
