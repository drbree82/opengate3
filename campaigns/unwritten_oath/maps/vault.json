    "#########################",
    "#...........#...........#",
    "#.T.........#.........T.#",
    "#.....C.M...#........E..#",
    "#...........D......c....#",
    "#......K.L..#.........I.#",
    "#...........#...........#",
    "#...........#.....F..P..#",
    "#...........#...........#",
    "#...........#........Q..#",
    "#...........#...........#",
