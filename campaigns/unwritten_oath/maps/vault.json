    "#....cA.....D..J..N.....#",
    "#...........#...........#",
    "#.Hs.B......#........G..#",
    "#...........#...........#",
    "#########################"
  ],
  "onEnter": [
    {
      "op": "flag.set",
      "flag": "cloud_active",
      "value": false
    },
    {
      "op": "flag.set",
      "flag": "cloud_steps",
      "value": 0
    }
  ],
  "triggers": {
    "cloud_step": {
      "once": false,
      "do": [
        {
          "op": "flag.inc",
          "flag": "cloud_steps",
          "by": -1,
          "if": {
            "flag": "cloud_active"
          }
        },
        {
          "op": "group.hostile",
          "group": "vault_collectors",
          "hostile": false,
          "if": {
            "flag": "cloud_active"
          }
        },
        {
          "op": "group.hostile",
          "group": "vault_collectors",
          "hostile": true,
          "if": {
            "all": [
              {
                "flag": "cloud_active"
              },
              {
                "flag": "cloud_steps",
                "equals": 0
              }
            ]
          }
        },
        {
          "op": "narrate",
          "text": "The invisible cloud fades. The guards are alert again.",
          "if": {
            "all": [
              {
                "flag": "cloud_active"
              },
              {
                "flag": "cloud_steps",
                "equals": 0
              }
            ]
          }
        },
        {
          "op": "flag.set",
          "flag": "cloud_active",
          "value": false,
          "if": {
            "flag": "cloud_steps",
            "equals": 0
          }
        }
      ]
    }
  }
}
