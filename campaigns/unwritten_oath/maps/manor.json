      "trigger": "cloud_step"
    },
    "E": {
      "entity": "family_seal",
      "trigger": "cloud_step"
    },
    "F": {
      "entity": "manor_to_vault",
      "trigger": "cloud_step"
    },
    "G": {
      "entity": "manor_to_court",
      "trigger": "cloud_step"
    },
    "H": {
      "entity": "approach_manor",
      "trigger": "cloud_step"
    },
    "I": {
      "entity": "skeleton",
      "group": "manor_dead",
      "aggro": 2.0,
      "trigger": "cloud_step"
    },
    "J": {
      "entity": "skeleton",
      "group": "manor_dead",
      "aggro": 2.0,
      "trigger": "cloud_step"
    },
    "K": {
      "entity": "cultist",
      "group": "manor_collectors",
      "aggro": 2.0,
